# ============================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ============================================

# Puerto del servidor (opcional, por defecto 3000)
PORT=3000

# API Key de OpenRouter para RecetaScan
# Obtén tu clave en: https://openrouter.ai/keys
# IMPORTANTE: Esta es una clave de ejemplo, debes reemplazarla con tu propia clave
OPENROUTER_API_KEY=tu_api_key_aqui

# Ejemplo de clave válida (debes obtener la tuya):
# OPENROUTER_API_KEY=sk-or-v1-abc123def456...

# ============================================
# INSTRUCCIONES:
# ============================================
# 1. Crea una cuenta en https://openrouter.ai
# 2. Ve a https://openrouter.ai/keys
# 3. Genera una nueva API key
# 4. Copia la key y pégala arriba reemplazando "tu_api_key_aqui"
# 5. Guarda este archivo
# 6. Reinicia el servidor con: node server.js
# ============================================